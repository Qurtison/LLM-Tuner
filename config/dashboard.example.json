{
  "server": {
    "host": "127.0.0.1",
    "port": 3000,
    "corsOrigins": [],
    "maxBodyBytes": 10485760
  },
  "paths": {
    "modelDirectories": [
      "./models"
    ],
    "huggingFaceCache": null,
    "logsDirectory": "./logs",
    "pythonCommand": "python3",
    "monitorScript": "./monitor.py"
  },
  "llama": {
    "builds": [],
    "defaultPort": 8080,
    "defaultHost": "127.0.0.1",
    "rpcPort": 50052
  },
  "telemetry": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8081,
    "pollMs": 1000,
    "providers": [
      "nvidia",
      "amd",
      "linux"
    ]
  },
  "processes": {
    "cleanupManagedPortsOnStart": false,
    "stopGraceMs": 3000
  },
  "worker": {
    "sshHost": "",
    "rpcTarget": "",
    "workDirectory": "",
    "startCommand": "docker compose -f docker-compose.worker.yml up -d",
    "stopCommand": "docker compose -f docker-compose.worker.yml down",
    "statusCommand": "docker compose -f docker-compose.worker.yml ps --filter status=running -q",
    "logsCommand": "docker compose -f docker-compose.worker.yml logs --tail=50",
    "transportPresets": []
  },
  "uiDefaults": {
    "contextSize": 4096,
    "gpuLayers": 0,
    "tensorSplit": 50,
    "temperature": 0.8
  }
}
